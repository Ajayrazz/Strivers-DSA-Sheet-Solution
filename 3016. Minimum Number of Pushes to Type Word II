class Solution {
    public int minimumPushes(String text) {
        int[] count = new int[26];
        for (int i = 0; i < text.length(); i++) {
            count[text.charAt(i) - 'a']++;
        }

        Arrays.sort(count);
        int presses = 0, position = 0;
        for (int i = 25; i >= 0; i--) {
            if (count[i] == 0) {
                break;
            }
            int cost = (position / 8) + 1;
            presses += cost * count[i];
            position++;
        }

        return presses;
    }
}
