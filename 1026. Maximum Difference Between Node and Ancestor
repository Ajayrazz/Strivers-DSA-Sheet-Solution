/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int max_diff = Integer.MIN_VALUE;
    public int maxAncestorDiff(TreeNode root) {
        Helper(root, new ArrayList<>());
        return max_diff;
    }

    //Helper Function
    public void Helper(TreeNode root, List<Integer> current){
        if(root == null) return;
        current.add(root.val);
        if(root.left == null && root.right == null){
            int max_val = Integer.MIN_VALUE, min_val = Integer.MAX_VALUE;
            for(int num : current){
                max_val = Math.max(max_val, num);
                min_val = Math.min(min_val, num);
            }

            //update max_diff
            if(max_val != Integer.MIN_VALUE && min_val != Integer.MAX_VALUE){
                max_diff = Math.max(max_diff, Math.abs(max_val - min_val));
            }
        }
        else {
            Helper(root.left, current);
            Helper(root.right, current);
        }
        //remove the last element
        current.remove(current.size() - 1);
    }
}
