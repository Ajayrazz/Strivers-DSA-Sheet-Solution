class Solution {
    public int minOperations(int[][] grid, int x) {
        int n = grid.length, m = grid[0].length;
        int[] arr = new int[n * m];
        int idx = 0;
        for(int i = 0; i < n; i++){
            for(int j = 0; j < m; j++){
                arr[idx++] = grid[i][j];
            }
        }

        Arrays.sort(arr);
        int min_op = 0;
        int median = arr[idx / 2];
        for(int i = 0; i < idx; i++){
            if(arr[i] % x != median % x){
                return -1;
            }

            //update min_op
            min_op += Math.abs((median - arr[i]) / x);
        }

        return min_op;
    }
}
