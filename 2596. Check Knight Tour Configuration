class Solution {
    public boolean checkValidGrid(int[][] grid) {
        int n = grid.length, m = grid[0].length;
        boolean[][] visited = new boolean[n][m];
        int[] dx = {2, 2, 1, -1, 1, -1, -2, -2};
        int[] dy = {1, -1, -2, -2, 2, 2, 1, -1};
        return dfs(0, 0, 0, grid, visited, dx, dy);
    }

    //dfs function
    public boolean dfs(int row, int col, int expected, int[][] grid, boolean[][] visited, int[] dx, int[] dy){
        if(grid[row][col] != expected) return false;
        visited[row][col] = true;
        if(expected == grid.length * grid.length - 1) return true;
        for(int index = 0; index < 8; index++){
            int nRow = row + dx[index];
            int nCol = col + dy[index];
            if(nRow >= 0 && nCol >= 0 && nRow < grid.length && nCol < grid.length && !visited[nRow][nCol] && grid[nRow][nCol] == expected + 1){
                return dfs(nRow, nCol, expected + 1, grid, visited, dx, dy);
            }
        }
        return false;
    }
}

//possible move
// 1. row + 2, col + 1 -- down
// 2. row + 2, col - 1 -- down
// 3. row + 1, col + 2 -- right
// 4. row - 1, col + 2 -- right
// 5. row - 2, col + 1 -- up
// 6. row - 2, col - 1 -- up
// 7. row + 1, col - 2 -- left
// 8. row - 1, col - 2 -- left

